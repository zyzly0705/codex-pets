    "currentPetJson": "pet.json",
    "preserveExistingRuntimePaths": true
  },
  "semantics": {
    "species": "human-like companion",
    "role": "small desktop life companion",
    "avoid": [
      "dog bowl",
      "kibble",
      "paw motif",
      "animal bed",
      "animal ears",
      "tail"
    ]
  },
  "identity": {
