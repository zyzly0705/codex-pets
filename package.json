{
  "name": "codex-desktop-pet",
  "version": "0.5.1",
  "description": "A small Windows desktop pet app for Codex pet spritesheets.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "start:debug": "YOYO_BEHAVIOR_DEBUG=1 electron .",
    "start:keyboard": "YOYO_ENABLE_UIOHOOK=1 electron .",
    "start:keyboard:win": "set YOYO_ENABLE_UIOHOOK=1&& electron .",
    "generate:actions": "node scripts/generate-action-spritesheet.js",
    "generate:typing": "node scripts/add-typing-companion-row.js",
    "generate:dharma": "node scripts/add-dharma-giant-rows.js",
    "design:performance": "node scripts/design-performance-aseprite.js",
    "design:mini-scenes": "node scripts/design-mini-scenes-aseprite.js",
    "design:yoyo-asset": "node scripts/prepare-yoyo-asset-run.js",
    "design:yoyo-effects-video": "node scripts/prepare-yoyo-effect-video-run.js",
    "design:yoyo-digsand-video": "node scripts/prepare-yoyo-digsand-video-run.js",
    "import:digsand-strip": "node scripts/import-digsand-video-strip.js",
    "import:ai-scenes": "node scripts/import-ai-scene-strips.js",
    "import:reference-sheet": "node scripts/import-reference-sheet.js",
    "import:reference-strips": "node scripts/import-reference-action-strips.js",
    "qa:animations": "node scripts/qa-animation-previews.js",
    "export:aseprite": "node scripts/export-aseprite-assets.js",
    "build:pet-assets": "node scripts/build-pet-assets.js",
    "build:home-assets": "node scripts/build-home-assets.js",
    "capture:home": "electron scripts/capture-home-scene.js",
    "audit:assets": "node scripts/audit-pet-assets.js",
    "audit:yoyo-redesign": "node scripts/audit-yoyo-redesign.js --allow-pending",
    "scaffold:pet": "node scripts/scaffold-pet-package.js",
    "expand:codex-atlas": "node scripts/expand-codex-atlas-to-yoyo.js",
    "generate:gugu-gaga": "node scripts/generate-gugu-gaga-local-spritesheet.js",
    "import:gugu-gaga": "node scripts/import-gugu-gaga-reference-sheet.js",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/home.js && node --check src/pixi-effect-stage.js && node -e \"const fs=require('fs'),cp=require('child_process');fs.readdirSync('src/main').filter(f=>f.endsWith('.js')).forEach(f=>cp.execSync('node --check src/main/'+f,{stdio:'inherit'}))\" && node -e \"const fs=require('fs'),cp=require('child_process');fs.readdirSync('src/shared').filter(f=>f.endsWith('.js')).forEach(f=>cp.execSync('node --check src/shared/'+f,{stdio:'inherit'}))\" && node -e \"require('fs').readdirSync('src/modules').forEach(f=>{require('child_process').execSync('node --check src/modules/'+f,{stdio:'inherit'})})\" && node scripts/validate-behavior-data.js && node scripts/smoke-ai-config.js && npm run audit:assets"
  },
  "keywords": [
    "desktop-pet",
    "codex-pet",
    "electron"
  ],
  "author": "Codex",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.codex.desktoppet",
    "productName": "Yoyo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/*/pet.json",
      "assets/*/spritesheet.webp",
      "assets/yoyo/effects/**/*",
      "assets/yoyo/home/**/*",
      "package.json",
      "!**/*.md",
      "!**/docs/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/*.map",
      "!assets/**/contact-sheet.*",
      "!assets/yoyo/*backup*",
      "!assets/yoyo/*expanded*",
      "!assets/yoyo/*before_*",
      "!assets/yoyo/*before_generated*",
      "!assets/yoyo/*original*",
      "!scripts/**"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodexDesktopPetSetup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Desktop Pet"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zyzly0705",
        "repo": "codex-pets"
      }
    ]
  },
  "dependencies": {
    "@pixi/particle-emitter": "^5.0.10",
    "electron-updater": "^6.1.0",
    "node-window-manager": "^2.2.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.18.1",
    "uiohook-napi": "^1.5.5"
  }
}
