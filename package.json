{
  "name": "codex-desktop-pet",
  "version": "0.3.3",
  "description": "A small Windows desktop pet app for Codex pet spritesheets.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "YOYO_BEHAVIOR_DEBUG=1 electron .",
    "start:keyboard": "YOYO_ENABLE_UIOHOOK=1 electron .",
    "start:keyboard:win": "set YOYO_ENABLE_UIOHOOK=1&& electron .",
    "generate:faces": "node scripts/generate-face-spritesheets.js",
    "generate:outfits": "node scripts/generate-outfit-spritesheets.js",
    "generate:actions": "node scripts/generate-action-spritesheet.js",
    "generate:typing": "node scripts/add-typing-companion-row.js",
    "generate:dharma": "node scripts/add-dharma-giant-rows.js",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node -e \"require('fs').readdirSync('src/modules').forEach(f=>{require('child_process').execSync('node --check src/modules/'+f,{stdio:'inherit'})})\""
  },
  "keywords": [
    "desktop-pet",
    "codex-pet",
    "electron"
  ],
  "author": "Codex",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.codex.desktoppet",
    "productName": "Yoyo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!assets/accessories/**",
      "!assets/xiao-hong/*backup*",
      "!assets/xiao-hong/*expanded*",
      "!assets/xiao-hong/*before_*",
      "!assets/xiao-hong/*before_generated*",
      "!assets/xiao-hong/*original*",
      "!scripts/**"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodexDesktopPetSetup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Desktop Pet"
    },
    "publish": [{
      "provider": "github",
      "owner": "zyzly0705",
      "repo": "codex-pets"
    }]
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "node-window-manager": "^2.2.4",
    "uiohook-napi": "^1.5.5"
  }
}
